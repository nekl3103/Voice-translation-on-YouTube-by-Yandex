{
  "manifest_version": 3,
  "name": "Video Voice Translate",
  "version": "0.2.0",
  "description": "Переводит субтитры видео и озвучивает перевод во время просмотра.",
  "minimum_chrome_version": "138",
  "incognito": "split",
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
